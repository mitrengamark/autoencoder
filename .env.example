WANDB_API_KEY=
WANDB_PROJECT=autoencoder-identification
HF_TOKEN=

# Ollama embedding (OpenAI-compatible /v1/embeddings)
OLLAMA_HOST=127.0.0.1:11434
OLLAMA_EMBED_MODEL=qwen3-embedding:latest

# System-wide memory watchdog: stop embed if MemAvailable falls below this (GiB).
# Watches the whole machine (all users), not just this project's cgroup.
EMBED_MIN_AVAIL_MEM_GB=5
EMBED_MEM_POLL_SEC=2
OOM_SCORE_ADJ=800
